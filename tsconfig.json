{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/stt/**/*.ts", "src/decision/**/*.ts", "src/commands/**/*.ts", "src/automation/**/*.ts", "src/browser/**/*.ts", "src/logging/**/*.ts", "src/types/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-renderer", "src/renderer"]
}
